# ===== Environment Variables für Gewobag Bot =====
# Kopiere diese Datei zu .env und passe die Werte an

# Zeitzone
TZ=Europe/Berlin

# Python-Einstellungen
PYTHONUNBUFFERED=1
PYTHONDONTWRITEBYTECODE=1

# Log-Level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Docker-spezifisch
PLAYWRIGHT_BROWSERS_PATH=/ms-playwright

# ===== Optionale Proxy-Einstellungen =====
# Uncomment wenn ein Proxy benötigt wird
# HTTP_PROXY=http://proxy.example.com:8080
# HTTPS_PROXY=http://proxy.example.com:8080
# NO_PROXY=localhost,127.0.0.1

# ===== Optionale Rate-Limiting-Einstellungen =====
# Wartezeit zwischen Bewerbungen in Sekunden (Standard: 30-60)
# MIN_DELAY_BETWEEN_APPLICATIONS=30
# MAX_DELAY_BETWEEN_APPLICATIONS=60

# ===== Optionale Browser-Einstellungen =====
# Headless-Modus (true/false)
# HEADLESS=true

# Browser-Timeout in Millisekunden
# BROWSER_TIMEOUT=60000

# ===== Optionale Retry-Einstellungen =====
# Maximale Anzahl Wiederholungsversuche bei Fehlern
# MAX_RETRIES=2

# Wartezeit zwischen Wiederholungen in Sekunden
# RETRY_DELAY=5

# ===== Datenbank-Einstellungen =====
# Pfad zur SQLite-Datenbank
# DATABASE_PATH=/app/data/gewobag_wohnungen.db

# ===== Cron-Einstellungen (für geplante Ausführung) =====
# Cron-Schedule (Beispiel: "0 */6 * * *" = alle 6 Stunden)
# CRON_SCHEDULE=0 */6 * * *

# ===== Benachrichtigungs-Einstellungen (Optional, zukünftige Feature) =====
# E-Mail-Benachrichtigungen
# NOTIFY_EMAIL=false
# EMAIL_RECIPIENT=ihre.email@example.com
# SMTP_SERVER=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=bot@example.com
# SMTP_PASSWORD=ihr_passwort

# Telegram-Benachrichtigungen
# NOTIFY_TELEGRAM=false
# TELEGRAM_BOT_TOKEN=your_bot_token
# TELEGRAM_CHAT_ID=your_chat_id

# ===== Sicherheits-Einstellungen =====
# Verschlüsselung für sensible Daten (zukünftiges Feature)
# ENCRYPT_USER_DATA=false
# ENCRYPTION_KEY=your_secret_key
